{
    "name": "barbosa89/hellen-suite",
    "type": "project",
    "description": "Hotel management application",
    "homepage": "https://hellensuite.com",
    "keywords": [
        "framework",
        "laravel",
        "hotels"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "cviebrock/eloquent-sluggable": "^9.0",
        "diglactic/laravel-breadcrumbs": "^9.0",
        "guzzlehttp/guzzle": "^7.8",
        "jamesmills/laravel-timezone": "^1.13",
        "kwn/number-to-words": "^2.9",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^9.52",
        "laravel/passport": "^12.2",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "laraveldaily/laravel-invoices": "^3.3",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.4",
        "owen-it/laravel-auditing": "^13.6",
        "shetabit/visitor": "^4.3",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-backup": "^8.2",
        "spatie/laravel-honeypot": "^4.5",
        "spatie/laravel-newsletter": "^5.1",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-view-models": "^1.6",
        "thepinecode/i18n": "^1.4",
        "tightenco/ziggy": "^2.2",
        "vinkla/hashids": "^10.0"
    },
    "require-dev": {
        "barbosa89/laravel-vue-i18n-generator": "^1.0",
        "barryvdh/laravel-debugbar": "^3.13",
        "beyondcode/laravel-dump-server": "^2.0",
        "beyondcode/laravel-query-detector": "^1.8",
        "bpocallaghan/generators": "^8.0",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.0.1",
        "mbezhanov/faker-provider-collection": "^2.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "nunomaduro/laravel-mojito": "^0.2.10",
        "phpunit/phpunit": "^9.6",
        "spatie/laravel-ignition": "^1.7"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "treeware/plant": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": [
            "vendor/bin/phpunit --verbose --testdox"
        ],
        "sail": "vendor/bin/sail"
    }
}
