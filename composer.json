{
    "name": "barbosa89/hellen-suite",
    "type": "project",
    "description": "Hotel management application",
    "homepage": "https://hellensuite.com",
    "keywords": [
        "framework",
        "laravel",
        "hotels"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "cviebrock/eloquent-sluggable": "^10.0",
        "diglactic/laravel-breadcrumbs": "^9.0",
        "drewm/mailchimp-api": "^2.5",
        "guzzlehttp/guzzle": "^7.8",
        "jamesmills/laravel-timezone": "^1.13",
        "kwn/number-to-words": "^2.9",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^10.10",
        "laravel/passport": "^12.2",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "laraveldaily/laravel-invoices": "^3.3",
        "maatwebsite/excel": "^3.1",
        "mews/purifier": "^3.4",
        "owen-it/laravel-auditing": "^13.6",
        "shetabit/visitor": "^4.3",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-backup": "^8.2",
        "spatie/laravel-honeypot": "^4.5",
        "spatie/laravel-newsletter": "^5.1",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-view-models": "^1.6",
        "tightenco/ziggy": "^2.2",
        "vinkla/hashids": "^11.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "beyondcode/laravel-dump-server": "^2.0",
        "beyondcode/laravel-query-detector": "^1.8",
        "bpocallaghan/generators": "^9.0",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.18",
        "mbezhanov/faker-provider-collection": "^2.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "nunomaduro/laravel-mojito": "^0.2.10",
        "phpunit/phpunit": "^10.1",
        "rector/rector": "^1.2",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "treeware/plant": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "XDEBUG_MODE=off vendor/bin/phpunit -d memory_limit=1024M",
        "test:debug": "vendor/bin/phpunit -d memory_limit=1024M",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit -d memory_limit=1024M",
        "sail": "vendor/bin/sail",
        "format": "vendor/bin/pint",
        "code:upgrade": "vendor/bin/rector"
    }
}
